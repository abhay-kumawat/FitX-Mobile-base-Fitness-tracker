# FitX AI Platform - Environment Variables Template
# Copy this file to .env for local development or set in production environment settings.

# Backend Configuration
PROJECT_NAME="FitX AI Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production" # options: development, production, test

# Security
SECRET_KEY="super-secret-fitx-ai-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: SQLite file in container/local filesystem. Change to PostgreSQL for production scale:
# DATABASE_URL="postgresql://user:password@localhost:5432/fitx_db"
DATABASE_URL="sqlite:///./fitx.db"

# AI Models - Google Gemini API Key
# Sign up at https://aistudio.google.com/ to get your free API key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
